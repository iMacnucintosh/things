[Desktop Entry]
Name=Things
GenericName=Gestor de paquetes
GenericName[en]=Package Manager
Comment=Gestor de paquetes (pacman · AUR · Flatpak)
Comment[en]=Package manager (pacman · AUR · Flatpak)
# Absolute via $HOME: launchers often lack ~/.local/bin in PATH.
Exec=/bin/sh -c 'exec "$HOME/.local/bin/things" "$@"' sh %U
Icon=things
Terminal=false
Type=Application
StartupNotify=true
Categories=System;PackageManager;
Keywords=packages;paquetes;pacman;aur;flatpak;software;instalar;things;
StartupWMClass=things
X-Things-ProductName=Things
