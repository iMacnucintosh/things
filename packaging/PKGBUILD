# Maintainer: iMacnucintosh
# Builds Things from the git repository (a -git package: pkgver follows the commits).
#   cd packaging && makepkg -si
pkgname=things-git
pkgver=0.0.0.r0.g0000000
pkgrel=1
pkgdesc="Package manager for Arch: pacman, AUR and Flatpak in one list, and the extensions of Sylphrena"
arch=('x86_64')
url="https://github.com/iMacnucintosh/things"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'pacman' 'sudo')
makedepends=('git')
optdepends=('yay: AUR packages'
            'flatpak: Flatpak apps'
            'archlinux-appstream-data: descriptions and icons of the Arch packages'
            'python: install Sylphrena extensions (uses its ext.py)')
provides=('things')
conflicts=('things')
# SYLPHRENA_REF=<tag> builds that release (the Sylphrena installer and its updates set it); without it, the latest commit
source=("git+${url}.git${SYLPHRENA_REF:+#tag=$SYLPHRENA_REF}")
sha256sums=('SKIP')

pkgver() {
  cd things
  # The release it was built from (v0.1.2 → 0.1.2.r0.g…), which is what the Sylphrena updates compare with
  local described
  if described="$(git describe --tags --long --match 'v0.*' 2>/dev/null)"; then
    printf '%s' "$described" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd things
  qmake6 PREFIX=/usr
  make
}

package() {
  cd things
  make INSTALL_ROOT="$pkgdir" install
  # The launcher entries (and Seeker's D-Bus service) start the user-local build in ~/.local/bin; a package lives in /usr/bin
  find "$pkgdir/usr/share" \( -name '*.desktop' -o -name '*.service' \) -exec sed -i -E \
    -e "s#/bin/sh -c 'exec \"\\\$HOME/\\.local/bin/things\" \"\\\$@\"' sh#/usr/bin/things#" \
    -e "s#/bin/sh -c 'exec \"\\\$HOME/\\.local/bin/things\"([^']*)'#/usr/bin/things\\1#" {} +
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
